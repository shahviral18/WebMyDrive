<?php
/**
 * One-shot migration — v2b (MySQL 5.7 compatible, no IF NOT EXISTS)
 * Uses try/catch per statement; "Duplicate column" errors are silently skipped.
 */
declare(strict_types=1);
header('Content-Type: application/json; charset=utf-8');

$expected = 'CMQ0LSJR84JZIH9PARSR5X9XYU2TPREV';
$given    = $_GET['token'] ?? '';
if (!hash_equals($expected, $given)) { http_response_code(403); echo json_encode(['error' => 'Forbidden']); exit; }

define('BASE_PATH', dirname(__DIR__));
require BASE_PATH . '/config/env.php';

$dsn = sprintf('mysql:host=%s;dbname=%s;charset=utf8mb4', DB_HOST, DB_NAME);
try {
    $pdo = new PDO($dsn, DB_USER, DB_PASS, [
        PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_EMULATE_PREPARES   => false,
        PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    ]);
} catch (PDOException $e) {
    http_response_code(500);
    echo json_encode(['error' => 'DB connect failed: ' . $e->getMessage()]);
    exit;
}

$statements = [
    "ALTER TABLE `User` ADD COLUMN `phone`         VARCHAR(50)  NULL AFTER `distributorId`",
    "ALTER TABLE `User` ADD COLUMN `country`       VARCHAR(100) NULL AFTER `phone`",
    "ALTER TABLE `User` ADD COLUMN `timezone`      VARCHAR(100) NULL AFTER `country`",
    "ALTER TABLE `User` ADD COLUMN `recoveryEmail` VARCHAR(255) NULL AFTER `timezone`",
    "ALTER TABLE `User` ADD COLUMN `recoveryPhone` VARCHAR(50)  NULL AFTER `recoveryEmail`",
    "ALTER TABLE `User` ADD COLUMN `storageUsed`   BIGINT NOT NULL DEFAULT 0 AFTER `recoveryPhone`",
    "ALTER TABLE `User` ADD COLUMN `storageLimit`  BIGINT NOT NULL DEFAULT 0 AFTER `storageUsed`",
];

$results = [];
foreach ($statements as $sql) {
    try {
        $pdo->exec($sql);
        $results[] = ['sql' => $sql, 'status' => 'added'];
    } catch (PDOException $e) {
        // SQLSTATE 42S21 = "Duplicate column name" — column already exists, skip
        $results[] = ['sql' => $sql, 'status' => ($e->getCode() === '42S21') ? 'already_exists' : 'error', 'message' => $e->getMessage()];
    }
}

@rename(__FILE__, str_replace('.php', '.done', __FILE__));

echo json_encode(['success' => true, 'migrated' => $results, 'note' => 'Script neutralized.'], JSON_PRETTY_PRINT);
