# WebMyDrive PHP Backend — Environment Variables
# Copy this file to .env and fill with real values.
# DO NOT commit .env to git.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Absolute or relative path to the Prisma-generated SQLite file.
# Default: server-php/../server/prisma/dev.db
DB_PATH=

# ── JWT ───────────────────────────────────────────────────────────────────────
# CHANGE THIS IN PRODUCTION — use a long random string (openssl rand -hex 32)
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRY=604800

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Leave blank to use DEMO MODE (simulated payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Site ──────────────────────────────────────────────────────────────────────
SITE_URL=https://webmydrive.com

# ── Logging ───────────────────────────────────────────────────────────────────
# Defaults to server-php/logs/ if not set
LOG_DIR=
