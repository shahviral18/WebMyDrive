generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            Int      @id @default(autoincrement())
  name          String?
  email         String   @unique
  passwordHash  String?
  referralCode  String?  @unique
  walletBalance Float    @default(0.0)
  role          String   @default("USER") // 'USER', 'ADMIN', 'SUPERADMIN'
  distributorId Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  distributor               Distributor?      @relation("DistributorCustomer", fields: [distributorId], references: [id])
  workspaces                Workspace[]
  orders                    Order[]
  referralsMade             ReferralLog[]     @relation("Referrer")
  referralsUsedBy           ReferralLog[]     @relation("Referee")
  distributorAccount        Distributor?      @relation("UserDistributor")
  distributorSalesPurchased DistributorSale[] @relation("PurchasingUserSales")

  @@index([email])
  @@index([referralCode])
  @@index([distributorId])
  @@index([role])
}

model Workspace {
  id               Int       @id @default(autoincrement())
  userId           Int
  planId           Int?
  domain           String?
  googleCustomerId String?
  status           String    @default("STATUS_PROVISIONING")
  renewalDate      DateTime?
  metadata         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id])
  plan Plan? @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
}

model Plan {
  id         Int         @id @default(autoincrement())
  name       String
  price      Float
  features   String?
  isActive   Boolean     @default(true)
  priceINR   Float?      // To match frontend expectations
  storageGB  Int         @default(0)
  maxUsers   Int         @default(0)
  googleSKU  String?
  workspaces Workspace[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Order {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Float
  currency    String   @default("INR")
  gatewayTxId String?  // Duplicate payment prevention enforced in application layer
  status      String   @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  referralLogs     ReferralLog[]
  distributorSales DistributorSale[]

  @@index([userId])
  @@index([status])
  @@index([gatewayTxId])
}

model ReferralLog {
  id             Int      @id @default(autoincrement())
  referrerUserId Int
  refereeUserId  Int
  orderId        Int?     @unique
  amount         Float
  referralYear   Int      @default(1)
  status         String   @default("PENDING") // PENDING, VESTED, CANCELLED, REDEEMED
  createdAt      DateTime @default(now())

  referrerUser User   @relation("Referrer", fields: [referrerUserId], references: [id])
  refereeUser  User?  @relation("Referee", fields: [refereeUserId], references: [id])
  order        Order? @relation(fields: [orderId], references: [id])

  // Duplicate referral credit prevention enforced in application layer
  @@index([referrerUserId])
  @@index([refereeUserId])
  @@index([orderId])
  @@index([status])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorId     Int?
  actionName  String
  payloadJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([actionName])
  @@index([createdAt])
}

model Distributor {
  id              Int       @id @default(autoincrement())
  userId          Int?      @unique
  email           String    @unique
  passwordHash    String?
  name            String?
  referralCode    String?   @unique
  walletBalance   Float     @default(0.0)
  tier            String    @default("Starter")
  status          String    @default("ACTIVE")
  joinDate        DateTime  @default(now())
  resetDate       DateTime?
  revenueThisYear Float     @default(0.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User?                 @relation("UserDistributor", fields: [userId], references: [id])
  customers User[]                @relation("DistributorCustomer")
  sales     DistributorSale[]
  walletTxs DistributorWalletTx[]

  @@index([status])
  @@index([tier])
  @@index([resetDate])
}

model DistributorSale {
  id               Int      @id @default(autoincrement())
  distributorId    Int
  purchasingUserId Int
  orderId          Int      @unique
  amount           Float
  commissionRate   Float
  commissionEarned Float
  saleYear         Int
  status           String   @default("COMPLETED")
  createdAt        DateTime @default(now())

  distributor    Distributor @relation(fields: [distributorId], references: [id])
  purchasingUser User        @relation("PurchasingUserSales", fields: [purchasingUserId], references: [id])
  order          Order       @relation(fields: [orderId], references: [id])

  // Duplicate commission prevention enforced in application layer
  @@index([distributorId])
  @@index([purchasingUserId])
  @@index([orderId])
}

model DistributorWalletTx {
  id            Int      @id @default(autoincrement())
  distributorId Int
  amount        Float
  type          String   // COMMISSION, PAYOUT, REFUND_FEE, FORFEIT
  status        String   @default("COMPLETED")
  description   String?
  createdAt     DateTime @default(now())

  distributor Distributor @relation(fields: [distributorId], references: [id])

  @@index([distributorId])
  @@index([type])
}

model AdminConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

